#!/usr/bin/env bash
# Run the checks. With no arguments, run all sections in order and stop at the first failure.
# Sections: contract core bench app python. Example: ./check contract python
set -euo pipefail

ROOT=$(cd "$(dirname "$0")" && pwd)
BUILD=${SCRIPT_BUILD:-"$HOME/Library/Caches/SCRIPT/$(basename "$ROOT")-$(printf %s "$ROOT" | shasum | cut -c1-8)"}
mkdir -p "$BUILD"
DESTINATION=${SCRIPT_DESTINATION:-'platform=iOS Simulator,name=iPad Pro 11-inch (M5),OS=latest'}
export UV_PROJECT_ENVIRONMENT="$BUILD/venv"
UV=(uv run --project "$ROOT/python" --frozen --quiet)

step() { printf '\n== %s\n' "$1"; }

contract() {
    step "contract: generated files match the generator"
    "${UV[@]}" scriptkin contract verify
}

python() {
    step "python: lint"
    "${UV[@]}" ruff check "$ROOT/python"
    "${UV[@]}" ruff format --check "$ROOT/python"
    step "python: types"
    (cd "$ROOT/python" && "${UV[@]}" pyright)
    step "python: tests"
    if [ -d "$BUILD/contract-out" ]; then
        export SCRIPT_CONTRACT_OUT="$BUILD/contract-out"
    fi
    if [ -n "$APP_RAN" ]; then
        export SCRIPT_REQUIRE_APP_EXPORTS=1
    fi
    if [ -n "$BENCH_RAN" ]; then
        export SCRIPT_REQUIRE_BENCH_EXPORTS=1
    fi
    # The unpacked public ParkinsonHW dataset, outside the repository. Its real-file tests skip without it.
    local parkinsonhw="/Volumes/T7 Shield/SCRIPT-records/data/parkinsonhw/extracted"
    if [ -z "${SCRIPT_PARKINSONHW:-}" ] && [ -d "$parkinsonhw" ]; then
        export SCRIPT_PARKINSONHW="$parkinsonhw"
    fi
    # -I keeps the folders that the tests read off the import path.
    (cd "$ROOT/python" && "${UV[@]}" python -I -m pytest -q)
}

core() {
    step "swift: ScriptCore tests on the Mac"
    # The Python tests read every export in this folder, so an export from an earlier run must not remain.
    rm -rf "$BUILD/contract-out"
    SCRIPT_CONTRACT_OUT="$BUILD/contract-out" swift test --package-path "$ROOT/app" --scratch-path "$BUILD/swiftpm"
}

# The revision that a build stamps into its Info.plist. A checkout with changes gets the suffix -dirty.
source_revision() {
    local revision
    revision=$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || echo unknown)
    if [ -n "$(git -C "$ROOT" status --porcelain 2>/dev/null)" ]; then revision="$revision-dirty"; fi
    echo "$revision"
}

# Fails when a String Catalog differs from the strings that the build found in the source.
# Arguments: the catalog, then the folder with the build's .stringsdata files.
catalog_matches_source() {
    # The copy keeps the file name of the catalog, because the file name selects the strings table.
    local catalog="$1" synced="$BUILD/$(basename "$1")" strings=()
    for data in "$2"/*/*.stringsdata; do
        strings+=(--stringsdata "$data")
    done
    cp "$catalog" "$synced"
    xcrun xcstringstool sync "$synced" "${strings[@]}"
    if ! cmp -s "$catalog" "$synced"; then
        echo "$catalog does not match the source strings. Update it: cp '$synced' '$catalog'" >&2
        return 1
    fi
}

bench() {
    local revision
    revision=$(source_revision)
    rm -rf "$BUILD/contract-out/bench"
    step "bench: ScriptBench tests on the Mac"
    rm -rf "$BUILD/bench-tests.xcresult"
    # xcodebuild passes a TEST_RUNNER_ variable to the test process without its prefix. The arch keeps the log free
    # of the warning about two matching Mac destinations.
    if ! TEST_RUNNER_SCRIPT_CONTRACT_OUT="$BUILD/contract-out" xcodebuild test -quiet \
        -project "$ROOT/app/ScriptApp.xcodeproj" -scheme ScriptBench -destination "platform=macOS,arch=$(uname -m)" \
        -derivedDataPath "$BUILD/DerivedData-bench" -resultBundlePath "$BUILD/bench-tests.xcresult" \
        SWIFT_TREAT_WARNINGS_AS_ERRORS=YES SCRIPT_SOURCE_REVISION="$revision" >"$BUILD/bench-tests.log" 2>&1; then
        tail -n 60 "$BUILD/bench-tests.log" >&2
        echo "bench tests failed. Log: $BUILD/bench-tests.log. Results: $BUILD/bench-tests.xcresult" >&2
        return 1
    fi

    step "bench: every UI string is in the String Catalog"
    catalog_matches_source "$ROOT/app/ScriptBench/Localizable.xcstrings" \
        "$BUILD/DerivedData-bench/Build/Intermediates.noindex/ScriptApp.build/Debug/ScriptBench.build/Objects-normal"
    BENCH_RAN=1
}

app() {
    local id=com.dvgyl.script.capture udid revision out="$BUILD/contract-out/app"
    rm -rf "$out"
    udid=$("${UV[@]}" python - "$DESTINATION" <<'PY'
import json, re, subprocess, sys
fields = dict(part.split("=", 1) for part in sys.argv[1].split(","))
if "id" in fields:
    sys.exit(print(fields["id"]))
listing = json.loads(subprocess.check_output(["xcrun", "simctl", "list", "-j", "devices", "available"]))
found = []
for runtime, devices in listing["devices"].items():
    version = re.search(r"iOS-([0-9-]+)$", runtime)
    for device in devices:
        if version and device["name"] == fields.get("name"):
            found.append((tuple(map(int, version[1].split("-"))), device["udid"]))
wanted = fields.get("OS", "latest")
found = [f for f in found if wanted == "latest" or ".".join(map(str, f[0])).startswith(wanted)]
sys.exit(print(max(found)[1]) if found else f"no available simulator for {sys.argv[1]}")
PY
)
    step "app: unit and UI tests on the simulator ($DESTINATION, $udid)"
    xcrun simctl boot "$udid" 2>/dev/null || true
    xcrun simctl bootstatus "$udid" -b >/dev/null
    # A new container for each run, so the copied exports are this run's only.
    xcrun simctl uninstall "$udid" "$id" 2>/dev/null || true
    revision=$(source_revision)
    rm -rf "$BUILD/app-tests.xcresult"
    if ! xcodebuild test -quiet -project "$ROOT/app/ScriptApp.xcodeproj" -scheme ScriptApp \
        -destination "platform=iOS Simulator,id=$udid" -derivedDataPath "$BUILD/DerivedData" \
        -resultBundlePath "$BUILD/app-tests.xcresult" \
        SWIFT_TREAT_WARNINGS_AS_ERRORS=YES SCRIPT_SOURCE_REVISION="$revision" >"$BUILD/app-tests.log" 2>&1; then
        tail -n 60 "$BUILD/app-tests.log" >&2
        echo "app tests failed. Log: $BUILD/app-tests.log. Results: $BUILD/app-tests.xcresult" >&2
        return 1
    fi

    step "app: copy the UI test exports to the contract output"
    local container
    container=$(xcrun simctl get_app_container "$udid" "$id" data)
    mkdir -p "$out"
    cp -R "$container/Documents/Exports/." "$out/"

    step "app: every UI string is in the String Catalog"
    catalog_matches_source "$ROOT/app/ScriptApp/Localizable.xcstrings" \
        "$BUILD/DerivedData/Build/Intermediates.noindex/ScriptApp.build/Debug-iphonesimulator/ScriptApp.build/Objects-normal"
    APP_RAN=1
}

APP_RAN=
BENCH_RAN=
uv sync --project "$ROOT/python" --frozen --quiet
sections=("$@")
[ ${#sections[@]} -eq 0 ] && sections=(contract core bench app python)
for section in "${sections[@]}"; do
    case "$section" in
        contract|core|bench|app|python) "$section" ;;
        *) echo "unknown section: $section (use: contract core bench app python)" >&2; exit 2 ;;
    esac
done
printf '\nall requested checks passed: %s\n' "${sections[*]}"
