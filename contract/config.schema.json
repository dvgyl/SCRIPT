{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dvgyl/SCRIPT/contract/config.schema.json",
  "title": "SCRIPT study configuration, format 1.0",
  "description": "The shape of a study configuration. scriptkin.studyconfig.validate and the app check the further rules in docs/DESIGN.md section 14.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "demo",
    "study",
    "sites",
    "jurisdictions",
    "administration",
    "battery",
    "tasks",
    "questionnaires",
    "locales",
    "safety",
    "consentModel",
    "ethics",
    "export",
    "operatorPin"
  ],
  "properties": {
    "format": {
      "const": "script.config"
    },
    "version": {
      "const": "1.0"
    },
    "demo": {
      "type": "boolean"
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "protocolVersion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,32}$"
        },
        "version": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        }
      }
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,32}$"
      }
    },
    "jurisdictions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "administration": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "supervised",
          "self"
        ]
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "practice",
          "attempts",
          "hands"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "practice": {
            "type": "boolean"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "hands": {
            "enum": [
              "dominant",
              "left",
              "right",
              "both"
            ]
          }
        }
      }
    },
    "questionnaires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "administration",
          "ageBand",
          "position",
          "instruments"
        ],
        "properties": {
          "administration": {
            "enum": [
              "supervised",
              "self"
            ]
          },
          "ageBand": {
            "enum": [
              "13-17",
              "18-24"
            ]
          },
          "position": {
            "enum": [
              "beforeTasks",
              "afterTasks"
            ]
          },
          "instruments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          }
        }
      }
    },
    "locales": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instructionVersion",
          "instructions"
        ],
        "properties": {
          "instructionVersion": {
            "type": "string"
          },
          "instructions": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionCodes",
        "remoteReview",
        "crisisLists"
      ],
      "properties": {
        "actionCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,32}$"
          }
        },
        "remoteReview": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reviewerRole",
                "imminentReviewWithinHours",
                "routineReviewWithinWeekdays",
                "exportEveryHours",
                "monitoringDisclosureVersion"
              ],
              "properties": {
                "reviewerRole": {
                  "type": "string",
                  "minLength": 1
                },
                "imminentReviewWithinHours": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "routineReviewWithinWeekdays": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "exportEveryHours": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "monitoringDisclosureVersion": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "crisisLists": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "jurisdiction",
              "locale",
              "version",
              "verifiedOn",
              "entries"
            ],
            "properties": {
              "jurisdiction": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "locale": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "verifiedOn": {
                "type": "string",
                "format": "date"
              },
              "entries": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "contact"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "contact": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "consentModel": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "documents"
        ],
        "properties": {
          "model": {
            "enum": [
              "adult",
              "guardianAndAssent",
              "waiver"
            ]
          },
          "documents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "waiverReference": {
            "type": "string"
          }
        }
      }
    },
    "ethics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approvalID",
        "protocolVersion",
        "safetyProtocolVersion"
      ],
      "properties": {
        "approvalID": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "string"
        },
        "safetyProtocolVersion": {
          "type": "string"
        },
        "monitoringDisclosureVersion": {
          "type": "string"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipientPublicKey",
        "keyID"
      ],
      "properties": {
        "recipientPublicKey": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "keyID": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "operatorPin": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "salt",
            "sha256"
          ],
          "properties": {
            "salt": {
              "type": "string",
              "minLength": 16
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      ]
    }
  }
}
